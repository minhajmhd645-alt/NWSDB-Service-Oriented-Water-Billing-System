  "components": {
    "schemas": {
      "AdminStatsDto": {
        "type": "object",
        "properties": {
          "totalCustomers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalBills": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unpaidBills": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "paidBills": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "overdueBills": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalPayments": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalRevenueCollected": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalOutstandingAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BillDto": {
        "type": "object",
        "properties": {
          "billId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "accountNumber": {
            "type": "string"
          },
          "billingMonth": {
            "type": "string"
          },
          "previousReading": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "currentReading": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unitsConsumed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "billAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateBillDto": {
        "required": [
          "accountNumber",
          "billingMonth",
          "dueDate"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "maxLength": 20,
            "type": "string"
          },
          "billingMonth": {
            "maxLength": 20,
            "type": "string"
          },
          "previousReading": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "currentReading": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "billAmount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "maxLength": 20,
            "type": "string"
          }
        }
      },
      "CreateCustomerDto": {
        "required": [
          "fullName",
          "address",
          "phoneNumber",
          "email"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "maxLength": 20,
            "type": "string"
          },
          "fullName": {
            "maxLength": 100,
            "type": "string"
          },
          "address": {
            "maxLength": 250,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "type": "string"
          }
        }
      },
      "CustomerDto": {
        "type": "object",
        "properties": {
          "accountNumber": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CustomerSummaryDto": {
        "type": "object",
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/CustomerDto"
          },
          "currentOutstandingAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
