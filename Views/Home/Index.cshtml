@model CustomerSummaryModel
@{
    ViewData["Title"] = "Customer Portal";
    var activeAcc = ViewBag.CurrentAccountNumber as string ?? "NWSDB10001";
}

<div class="container mt-4">
    <!-- Hero Banner -->
    <div class="hero-banner mb-4">
        <div class="row align-items-center">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <span class="badge bg-white text-navy mb-2 px-3 py-2 fw-semibold fs-7"><i class="bi bi-shield-check me-1 text-primary"></i> Official Customer Self-Service Portal</span>
                <h1 class="display-5 fw-bold text-white mb-2">Manage Your Water Bills & Payments Online</h1>
                <p class="fs-6 text-white-50 mb-4">
                    Fast, secure, and convenient water bill payments powered by NWSDB REST Integration Services.
                </p>

                <!-- Quick Account Switch Form -->
                <form asp-controller="Home" asp-action="SelectAccount" method="post" class="bg-white p-2 rounded-3 shadow-lg d-flex align-items-center">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-person-bounding-box text-primary fs-5"></i></span>
                        <input type="text" name="AccountNumber" value="@activeAcc" class="form-control border-0 fs-6 shadow-none" placeholder="Enter NWSDB Account (e.g. NWSDB10001)" required />
                        <button type="submit" class="btn btn-primary px-4 fw-semibold rounded-2"><i class="bi bi-arrow-right-circle me-1"></i> Access Portal</button>
                    </div>
                </form>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-20 backdrop-blur">
                    <i class="bi bi-droplet-half text-info" style="font-size: 5rem;"></i>
                    <h5 class="text-white mt-2">Active Customer Account</h5>
                    <div class="fs-4 fw-bold text-warning">@activeAcc</div>
                    @if (Model?.Customer != null)
                    {
                        <p class="fs-7 text-white-50 mb-0">@Model.Customer.FullName | @Model.Customer.Address</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Test Accounts Bar -->
    <div class="card card-custom mb-4 border-start border-4 border-info">
        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-check-fill text-info fs-4 me-2"></i>
                <div>
                    <strong class="d-block">Demo Test Accounts:</strong>
                    <span class="fs-8 text-muted">Click any account below to switch the active session instantly</span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <form asp-controller="Home" asp-action="SelectAccount" method="post" class="d-inline">
                    <input type="hidden" name="AccountNumber" value="NWSDB10001" />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold @(activeAcc == "NWSDB10001" ? "active" : "")">
                        NWSDB10001 (Sunil)
                    </button>
                </form>
                <form asp-controller="Home" asp-action="SelectAccount" method="post" class="d-inline">
                    <input type="hidden" name="AccountNumber" value="NWSDB10002" />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold @(activeAcc == "NWSDB10002" ? "active" : "")">
                        NWSDB10002 (Nimal)
                    </button>
                </form>
                <form asp-controller="Home" asp-action="SelectAccount" method="post" class="d-inline">
                    <input type="hidden" name="AccountNumber" value="NWSDB10003" />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold @(activeAcc == "NWSDB10003" ? "active" : "")">
                        NWSDB10003 (Kamala)
                    </button>
                </form>
                <form asp-controller="Home" asp-action="SelectAccount" method="post" class="d-inline">
                    <input type="hidden" name="AccountNumber" value="NWSDB10004" />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold @(activeAcc == "NWSDB10004" ? "active" : "")">
                        NWSDB10004 (Roshan)
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Customer != null)
    {
        <!-- Summary Stats Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-6 col-lg-3">
                <div class="card card-custom h-100 p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div>
                            <span class="fs-8 text-muted text-uppercase fw-bold">Outstanding Balance</span>
                            <h3 class="fw-bold mb-0 text-navy">Rs. @Model.CurrentOutstandingAmount.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-custom h-100 p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning-subtle text-warning me-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div>
                            <span class="fs-8 text-muted text-uppercase fw-bold">Unpaid Bills</span>
                            <h3 class="fw-bold mb-0 text-navy">@Model.NumberOfUnpaidBills <span class="fs-7 fw-normal text-muted">bill(s)</span></h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-custom h-100 p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-info-subtle text-info me-3">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <div>
                            <span class="fs-8 text-muted text-uppercase fw-bold">Current Usage</span>
                            <h3 class="fw-bold mb-0 text-navy">@(Model.CurrentWaterUsage?.UnitsConsumed ?? 0) <span class="fs-7 fw-normal text-muted">Units</span></h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-custom h-100 p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success-subtle text-success me-3">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div>
                            <span class="fs-8 text-muted text-uppercase fw-bold">Latest Payment</span>
                            <h3 class="fw-bold mb-0 text-navy">
                                @(Model.LatestPayment != null ? $"Rs. {Model.LatestPayment.Amount:N2}" : "None")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Primary Quick Actions Grid -->
    <h5 class="fw-bold text-navy mb-3"><i class="bi bi-grid-fill me-2 text-primary"></i>Customer Services & Quick Actions</h5>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 text-center p-4">
                <div class="mx-auto mb-3 stat-icon bg-primary-subtle text-primary" style="width:60px; height:60px;">
                    <i class="bi bi-person-vcard fs-3"></i>
                </div>
                <h5 class="fw-bold">Account Info</h5>
                <p class="fs-7 text-muted">View profile details, registered address, and account summary.</p>
                <a asp-controller="Account" asp-action="Index" class="btn btn-outline-primary btn-sm mt-auto fw-semibold">View Profile</a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 text-center p-4">
                <div class="mx-auto mb-3 stat-icon bg-warning-subtle text-warning" style="width:60px; height:60px;">
                    <i class="bi bi-exclamation-octagon fs-3"></i>
                </div>
                <h5 class="fw-bold">Unpaid Bills</h5>
                <p class="fs-7 text-muted">Check pending bills and proceed directly with instant payment.</p>
                <a asp-controller="Bills" asp-action="Unpaid" class="btn btn-warning btn-sm mt-auto fw-semibold text-dark"><i class="bi bi-lightning-fill me-1"></i> Pay Now</a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 text-center p-4">
                <div class="mx-auto mb-3 stat-icon bg-info-subtle text-info" style="width:60px; height:60px;">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
                <h5 class="fw-bold">All Bills</h5>
                <p class="fs-7 text-muted">Access your complete history of monthly water bills and readings.</p>
                <a asp-controller="Bills" asp-action="Index" class="btn btn-outline-primary btn-sm mt-auto fw-semibold">Billing History</a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 text-center p-4">
                <div class="mx-auto mb-3 stat-icon bg-success-subtle text-success" style="width:60px; height:60px;">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
                <h5 class="fw-bold">Payment History</h5>
                <p class="fs-7 text-muted">View past payment receipts, transaction IDs, and dates.</p>
                <a asp-controller="Payments" asp-action="History" class="btn btn-outline-primary btn-sm mt-auto fw-semibold">Payment Records</a>
            </div>
        </div>
    </div>
</div>
