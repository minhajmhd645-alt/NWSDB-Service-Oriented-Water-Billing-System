@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = Configuration["NwsdbApi:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7194";
    var scalarUrl = $"{apiBaseUrl}/scalar/v1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NWSDB Customer Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-soft">

    <!-- Top Gov Bar -->
    <div class="bg-gov-dark text-white py-1 fs-7">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-shield-check text-info me-1"></i>
                <span class="fw-semibold">National Water Supply & Drainage Board</span> | Sri Lanka Customer Portal
            </div>
            <div class="d-none d-md-flex align-items-center gap-3">
                <a href="@scalarUrl" target="_blank" rel="noopener noreferrer" class="text-info text-decoration-none fw-semibold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> View NWSDB API
                </a>
                <span><i class="bi bi-telephone-fill text-warning me-1"></i> Emergency Hotline: <strong>1939</strong></span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 42px; height: 42px;">
                        <i class="bi bi-droplet-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="fw-bold fs-4 text-navy tracking-tight d-block leading-none">NWSDB</span>
                        <span class="fs-8 text-muted fw-semibold">WATER SERVICES PORTAL</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Account" asp-action="Index"><i class="bi bi-person-badge me-1"></i> Account Details</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Bills" asp-action="Index"><i class="bi bi-file-earmark-text me-1"></i> All Bills</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Bills" asp-action="Unpaid"><i class="bi bi-exclamation-circle me-1"></i> Unpaid Bills</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Payments" asp-action="History"><i class="bi bi-clock-history me-1"></i> Payment History</a>
                        </li>
                        
                        <!-- Admin Control Panel Menu -->
                        <li class="nav-item dropdown ms-lg-2 my-1 my-lg-0">
                            <a class="nav-link dropdown-toggle bg-navy text-white rounded px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock-fill text-warning"></i> Admin Panel
                            </a>
                            <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="adminDropdown">
                                <li>
                                    <a class="dropdown-item py-2 fw-medium" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2 text-primary me-2"></i> Admin Dashboard
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium" asp-controller="Admin" asp-action="Customers">
                                        <i class="bi bi-people-fill text-success me-2"></i> Manage Customers
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium" asp-controller="Admin" asp-action="Bills">
                                        <i class="bi bi-receipt-cutoff text-info me-2"></i> Manage Bills
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium" asp-controller="Admin" asp-action="Payments">
                                        <i class="bi bi-credit-card-2-front-fill text-warning me-2"></i> Payment Records
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Quick Switch Account Form -->
                        <form class="d-flex align-items-center" asp-controller="Home" asp-action="SelectAccount" method="post">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="AccountNumber" class="form-control form-control-sm border-start-0" placeholder="Account (e.g. NWSDB10001)" required />
                                <button type="submit" class="btn btn-primary btn-sm fw-semibold">Switch</button>
                            </div>
                        </form>

                        <!-- View NWSDB API Button -->
                        <a href="@scalarUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info btn-sm fw-semibold text-nowrap">
                            <i class="bi bi-code-square me-1"></i> View NWSDB API
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer bg-navy text-white mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                            <i class="bi bi-droplet-fill fs-5"></i>
                        </div>
                        <span class="fw-bold fs-4 text-white">NWSDB Portal</span>
                    </div>
                    <p class="text-white-50 fs-7 mb-3">
                        Providing safe, clean drinking water and sustainable sewerage infrastructure across Sri Lanka.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">REST API Connected</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-8">Secure Gateway</span>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Quick Navigation</h6>
                    <ul class="list-unstyled fs-7 space-y-2 text-white-50">
                        <li><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-white">Dashboard</a></li>
                        <li><a asp-controller="Account" asp-action="Index" class="text-white-50 text-decoration-none hover-white">Account Info</a></li>
                        <li><a asp-controller="Bills" asp-action="Unpaid" class="text-white-50 text-decoration-none hover-white">Unpaid Bills</a></li>
                        <li><a asp-controller="Payments" asp-action="History" class="text-white-50 text-decoration-none hover-white">Payment Records</a></li>
                        <li><a href="@scalarUrl" target="_blank" rel="noopener noreferrer" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-box-arrow-up-right me-1"></i> View NWSDB API</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <h6 class="fw-bold text-white mb-3">Demo Test Accounts</h6>
                    <ul class="list-unstyled fs-7 text-white-50">
                        <li><span class="text-white fw-medium">NWSDB10001</span> — Sunil Perera</li>
                        <li><span class="text-white fw-medium">NWSDB10002</span> — Nimal Silva</li>
                        <li><span class="text-white fw-medium">NWSDB10003</span> — Kamala Fernando</li>
                        <li><span class="text-white fw-medium">NWSDB10004</span> — Roshan Jayawardena</li>
                    </ul>
                </div>

                <div class="col-lg-3">
                    <h6 class="fw-bold text-white mb-3">Customer Support</h6>
                    <p class="text-white-50 fs-7 mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i> Head Office: Galle Road, Ratmalana, Sri Lanka</p>
                    <p class="text-white-50 fs-7 mb-2"><i class="bi bi-telephone me-2 text-primary"></i> Call Center: <strong>1939</strong></p>
                    <p class="text-white-50 fs-7 mb-0"><i class="bi bi-envelope me-2 text-primary"></i> Email: info@waterboard.lk</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-3" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center fs-8 text-white-50">
                <div>&copy; 2026 National Water Supply and Drainage Board. All rights reserved.</div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
