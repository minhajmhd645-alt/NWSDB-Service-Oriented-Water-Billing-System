@model BillsListViewModel
@{
    ViewData["Title"] = "All Bills";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">All Bills</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Billing History</h2>
            <p class="text-muted fs-7 mb-0">Customer: <strong>@Model.CustomerName</strong> (@Model.AccountNumber)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Bills" asp-action="Unpaid" class="btn btn-warning btn-sm fw-semibold"><i class="bi bi-filter me-1"></i> Show Unpaid Only</a>
            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Account Info</a>
        </div>
    </div>

    @if (!Model.Bills.Any())
    {
        <div class="card card-custom p-5 text-center">
            <i class="bi bi-inbox text-muted fs-1 mb-2"></i>
            <h5 class="fw-bold text-muted">No Bills Found</h5>
            <p class="fs-7 text-muted">There are no billing records available for account @Model.AccountNumber.</p>
        </div>
    }
    else
    {
        <div class="card card-custom overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="fs-7 text-uppercase text-muted">
                            <th class="ps-4">Bill Ref</th>
                            <th>Billing Period</th>
                            <th>Reading (Prev → Curr)</th>
                            <th>Units</th>
                            <th>Bill Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-navy">#BILL-@bill.BillId</td>
                                <td>@bill.BillingMonth</td>
                                <td class="fs-7">@bill.PreviousReading &rarr; @bill.CurrentReading</td>
                                <td><span class="badge bg-light text-dark border">@bill.UnitsConsumed Units</span></td>
                                <td class="fw-bold text-navy">Rs. @bill.BillAmount.ToString("N2")</td>
                                <td class="fs-7">@bill.DueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (bill.Status == "Paid")
                                    {
                                        <span class="badge badge-paid px-3 py-1 fw-semibold"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                    }
                                    else if (bill.Status == "Overdue")
                                    {
                                        <span class="badge badge-overdue px-3 py-1 fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i>Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-unpaid px-3 py-1 fw-semibold"><i class="bi bi-clock me-1"></i>Unpaid</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (bill.Status != "Paid")
                                    {
                                        <a asp-controller="Payments" asp-action="Pay" asp-route-billId="@bill.BillId" class="btn btn-warning btn-sm fw-semibold text-dark">
                                            <i class="bi bi-lightning-fill me-1"></i> Pay Now
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8"><i class="bi bi-check2-all text-success"></i> Settled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
