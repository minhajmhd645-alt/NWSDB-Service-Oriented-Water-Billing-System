@model PaymentFormViewModel
@{
    ViewData["Title"] = "Execute Payment";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Bills" asp-action="Unpaid">Unpaid Bills</a></li>
            <li class="breadcrumb-item active">Pay Bill #@Model.BillId</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-custom overflow-hidden">
                <div class="card-header bg-navy text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-navy mb-1 fw-semibold fs-8">NWSDB ONLINE PAYMENT GATEWAY</span>
                            <h3 class="fw-bold mb-0">Water Bill Payment</h3>
                        </div>
                        <i class="bi bi-shield-lock fs-1 text-info opacity-75"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Payment Failed</strong>
                                <div>@Model.ErrorMessage</div>
                            </div>
                        </div>
                    }

                    <!-- Summary Box -->
                    <div class="p-4 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-navy mb-3 pb-2 border-bottom"><i class="bi bi-receipt me-2 text-primary"></i>Bill Details</h6>
                        <div class="row g-3 fs-7">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Customer Account:</span>
                                <strong class="fs-6 text-dark">@Model.AccountNumber</strong> (@Model.CustomerName)
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Bill Reference:</span>
                                <strong class="fs-6 text-dark">#BILL-@Model.BillId</strong> (@Model.BillingMonth)
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Due Date:</span>
                                <span class="text-danger fw-semibold">@Model.DueDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Payment Destination:</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">NWSDB REST Gateway</span>
                            </div>
                        </div>

                        <hr class="my-3 opacity-25" />

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-navy fs-6">Fixed Bill Amount:</span>
                            <span class="fs-3 fw-bold text-navy">Rs. @Model.BillAmount.ToString("N2")</span>
                        </div>
                        <small class="text-muted fs-8 d-block text-end">* Amount is retrieved from official NWSDB records and cannot be altered.</small>
                    </div>

                    <!-- Payment Form -->
                    <form asp-controller="Payments" asp-action="Pay" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BillId" />
                        <input type="hidden" asp-for="AccountNumber" />
                        <input type="hidden" asp-for="CustomerName" />
                        <input type="hidden" asp-for="BillAmount" />
                        <input type="hidden" asp-for="BillingMonth" />

                        <h6 class="fw-bold text-navy mb-3"><i class="bi bi-bank me-2 text-primary"></i>Demo Bank Payment Options</h6>

                        <div class="mb-3">
                            <label class="form-label fw-semibold fs-7">Select Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select" readonly>
                                <option value="DemoBankAccount" selected>Demo Bank Account (REST Integration)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BankAccountNumber" class="form-label fw-semibold fs-7"></label>
                            <input asp-for="BankAccountNumber" class="form-control form-control-lg fw-bold tracking-tight" placeholder="e.g. DEMO-BANK-001" required />
                            <span asp-validation-for="BankAccountNumber" class="text-danger fs-8"></span>
                            <div class="form-text fs-8">
                                Select a demo account number with sufficient balance:
                                <strong>DEMO-BANK-001</strong> (50,000 LKR),
                                <strong>DEMO-BANK-002</strong> (12,000 LKR),
                                <strong>DEMO-BANK-003</strong> (75,000 LKR), or
                                <span class="text-danger fw-semibold">DEMO-BANK-004</span> (500 LKR - Low Balance Test).
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark py-3">
                                <i class="bi bi-lock-fill me-1"></i> Confirm & Authorize Payment of Rs. @Model.BillAmount.ToString("N2")
                            </button>
                            <a asp-controller="Bills" asp-action="Unpaid" class="btn btn-outline-secondary btn-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
