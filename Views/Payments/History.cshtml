@model List<PaymentModel>
@{
    ViewData["Title"] = "Payment History";
    var acc = ViewBag.AccountNumber as string ?? "";
    var name = ViewBag.CustomerName as string ?? acc;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Payment History</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>Payment History</h2>
            <p class="text-muted fs-7 mb-0">Customer: <strong>@name</strong> (@acc)</p>
        </div>
        <div>
            <a asp-controller="Bills" asp-action="Unpaid" class="btn btn-warning btn-sm fw-semibold"><i class="bi bi-credit-card me-1"></i> Pay Unpaid Bills</a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card card-custom p-5 text-center">
            <i class="bi bi-clock-slash text-muted fs-1 mb-2"></i>
            <h5 class="fw-bold text-muted">No Payment History Found</h5>
            <p class="fs-7 text-muted">There are no recorded payment transactions for account @acc yet.</p>
        </div>
    }
    else
    {
        <div class="card card-custom overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="fs-7 text-uppercase text-muted">
                            <th class="ps-4">Payment ID</th>
                            <th>Bill Ref</th>
                            <th>Amount</th>
                            <th>Bank Transaction ID</th>
                            <th>Payment Method</th>
                            <th>Payment Date</th>
                            <th class="pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-navy">#PAY-@p.PaymentId</td>
                                <td class="fw-semibold">#BILL-@p.BillId</td>
                                <td class="fw-bold text-success">Rs. @p.Amount.ToString("N2")</td>
                                <td><code class="text-primary bg-light px-2 py-1 rounded">@p.TransactionId</code></td>
                                <td><span class="badge bg-secondary-subtle text-dark border">@p.PaymentMethod</span></td>
                                <td class="fs-7">@p.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="pe-4 text-end">
                                    <span class="badge badge-paid px-3 py-1 fw-semibold"><i class="bi bi-check-circle me-1"></i>@p.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
