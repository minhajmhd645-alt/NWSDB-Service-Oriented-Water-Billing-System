@model EditCustomerViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container mt-4" style="max-width: 800px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Customer Management</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Customer</li>
        </ol>
    </nav>

    <!-- Form Card -->
    <div class="card card-custom shadow-lg">
        <div class="card-header bg-navy text-white p-4 rounded-top-3">
            <div class="d-flex align-items-center">
                <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Edit Customer Profile</h4>
                    <p class="text-white-50 fs-7 mb-0">Update contact and address details for <strong>@Model.AccountNumber</strong>.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Edit" asp-route-accountNumber="@Model.AccountNumber" method="post" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 fs-7" role="alert"></div>

                <!-- Account Number (Read Only) -->
                <div class="mb-4 p-3 bg-light rounded border border-warning-subtle">
                    <label asp-for="AccountNumber" class="form-label fw-bold fs-7 text-navy"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock-fill text-warning"></i></span>
                        <input asp-for="AccountNumber" class="form-control bg-white font-monospace fw-bold" readonly />
                    </div>
                    <div class="form-text fs-8 text-muted"><i class="bi bi-shield-lock me-1"></i> Account Number is a primary identifier and cannot be modified.</div>
                </div>

                <div class="row g-4">
                    <!-- Full Name -->
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-bold fs-7 text-navy"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person text-primary"></i></span>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger fs-8"></span>
                    </div>

                    <!-- Registered Address -->
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold fs-7 text-navy"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-geo-alt text-primary"></i></span>
                            <input asp-for="Address" class="form-control" required />
                        </div>
                        <span asp-validation-for="Address" class="text-danger fs-8"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-bold fs-7 text-navy"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone text-primary"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" required />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger fs-8"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold fs-7 text-navy"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-primary"></i></span>
                            <input asp-for="Email" type="email" class="form-control" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger fs-8"></span>
                    </div>
                </div>

                <hr class="my-4 opacity-25" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
