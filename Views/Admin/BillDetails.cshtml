@model NWSDB.Web.Models.BillModel
@{
    ViewData["Title"] = $"Bill #{Model.BillId} Details - NWSDB Admin";
    var customer = ViewBag.Customer as NWSDB.Web.Models.CustomerModel;
    var statusClass = Model.Status switch
    {
        "Paid" => "bg-success-subtle text-success border border-success-subtle",
        "Overdue" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
    };
    var isOverdue = Model.Status == "Overdue" || (Model.Status == "Unpaid" && Model.DueDate < DateTime.UtcNow);
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Control Panel</a></li>
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Bills" class="text-decoration-none">Bills</a></li>
            <li class="breadcrumb-item active" aria-current="page">Bill #@Model.BillId</li>
        </ol>
    </nav>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <!-- Bill Card -->
            <div class="card border-0 shadow rounded-3">
                <!-- Card Header with status bar -->
                <div class="card-header p-4 border-0 @(Model.Status == "Paid" ? "bg-success" : isOverdue ? "bg-danger" : "bg-navy") text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-white text-dark font-monospace fs-7 px-3 py-2 mb-2">BILL #@Model.BillId</span>
                            <h4 class="fw-bold text-white mb-1">
                                <i class="bi bi-file-earmark-text-fill me-2"></i>
                                Water Service Bill — @Model.BillingMonth
                            </h4>
                            <p class="text-white-50 mb-0">National Water Supply & Drainage Board, Sri Lanka</p>
                        </div>
                        <span class="badge @statusClass fs-6 px-3 py-2">@Model.Status</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Customer Info -->
                    @if (customer != null)
                    {
                        <div class="alert alert-light border-start border-primary border-4 mb-4">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="fw-bold text-navy"><i class="bi bi-person-badge-fill text-primary me-2"></i>@customer.AccountNumber</div>
                                    <div class="fw-semibold">@customer.FullName</div>
                                    <div class="text-muted fs-7">@customer.Address</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted fs-7"><i class="bi bi-telephone me-1"></i> @customer.PhoneNumber</div>
                                    <div class="text-muted fs-7"><i class="bi bi-envelope me-1"></i> @customer.Email</div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Meter Readings -->
                    <div class="card border border-info-subtle bg-info-subtle rounded-3 mb-4">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-info mb-3"><i class="bi bi-speedometer2 me-2"></i> Meter Readings</h6>
                            <div class="row text-center g-3">
                                <div class="col-4">
                                    <div class="fs-7 text-muted fw-semibold text-uppercase mb-1">Previous</div>
                                    <div class="fs-4 fw-bold text-navy">@Model.PreviousReading</div>
                                    <small class="text-muted">units</small>
                                </div>
                                <div class="col-4 border-start border-end border-info-subtle">
                                    <div class="fs-7 text-muted fw-semibold text-uppercase mb-1">Current</div>
                                    <div class="fs-4 fw-bold text-navy">@Model.CurrentReading</div>
                                    <small class="text-muted">units</small>
                                </div>
                                <div class="col-4">
                                    <div class="fs-7 text-muted fw-semibold text-uppercase mb-1">Consumed</div>
                                    <div class="fs-4 fw-bold text-info">@Model.UnitsConsumed</div>
                                    <small class="text-muted">units</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Summary -->
                    <table class="table table-borderless fs-7 mb-0">
                        <tr>
                            <td class="text-muted fw-semibold py-2">Billing Period</td>
                            <td class="fw-bold text-end py-2">@Model.BillingMonth</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Units Consumed</td>
                            <td class="fw-bold text-end py-2">@Model.UnitsConsumed units</td>
                        </tr>
                        <tr class="border-top">
                            <td class="fw-bold text-navy py-3 fs-6">Bill Amount</td>
                            <td class="fw-bold text-primary fs-5 text-end py-3">Rs. @Model.BillAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Due Date</td>
                            <td class="fw-@(isOverdue ? "bold text-danger" : "semibold") text-end py-2">
                                @Model.DueDate.ToLocalTime().ToString("dd MMMM yyyy")
                                @if (isOverdue && Model.Status != "Paid") { <span class="badge bg-danger-subtle text-danger ms-1">OVERDUE</span> }
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="card-footer bg-white border-0 p-4 pt-0 d-flex justify-content-between">
                    <a asp-controller="Admin" asp-action="Bills" class="btn btn-outline-secondary fw-semibold px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Bills
                    </a>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(Model.AccountNumber))
                        {
                            <a asp-controller="Admin" asp-action="Bills" asp-route-searchAccount="@Model.AccountNumber" class="btn btn-outline-info fw-semibold">
                                <i class="bi bi-list-ul me-1"></i> All Acct Bills
                            </a>
                        }
                        <a asp-controller="Admin" asp-action="EditBill" asp-route-billId="@Model.BillId" class="btn btn-primary fw-semibold px-4">
                            <i class="bi bi-pencil-fill me-1"></i> Edit Bill
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
