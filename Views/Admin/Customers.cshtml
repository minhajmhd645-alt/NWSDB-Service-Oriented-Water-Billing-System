@model NWSDB.Web.Models.CustomerListViewModel
@{
    ViewData["Title"] = "Customer Administration - NWSDB Admin Control Panel";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Control Panel</a></li>
            <li class="breadcrumb-item active" aria-current="page">Customer Administration</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-people-fill text-primary me-2"></i> Customer Administration</h2>
            <p class="text-muted mb-0">View, create, and maintain registered NWSDB customer records.</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="CreateCustomer" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Customer
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="Admin" asp-action="Customers" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by Account Number, Name, Address, Phone or Email..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-semibold w-100">
                        <i class="bi bi-funnel-fill me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-secondary">Reset</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Customer Table Card -->
    <div class="card border-0 shadow-sm bg-white">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-navy mb-0">Total Registered Customers: <span class="badge bg-navy">@Model.Customers.Count()</span></h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-7">
                <thead class="table-light text-muted fw-semibold">
                    <tr>
                        <th>Account Number</th>
                        <th>Full Name</th>
                        <th>Registered Address</th>
                        <th>Phone Number</th>
                        <th>Email Address</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Customers.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-person-x fs-1 d-block text-secondary mb-2"></i>
                                No customers found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var customer in Model.Customers)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-7">
                                        @customer.AccountNumber
                                    </span>
                                </td>
                                <td class="fw-bold text-navy">@customer.FullName</td>
                                <td>@customer.Address</td>
                                <td><i class="bi bi-telephone text-muted me-1"></i> @customer.PhoneNumber</td>
                                <td class="text-muted"><i class="bi bi-envelope text-muted me-1"></i> @customer.Email</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Admin" asp-action="EditCustomer" asp-route-accountNumber="@customer.AccountNumber" class="btn btn-outline-secondary" title="Edit Customer">
                                            <i class="bi bi-pencil-fill me-1"></i> Edit
                                        </a>
                                        <a asp-controller="Admin" asp-action="Bills" asp-route-searchAccount="@customer.AccountNumber" class="btn btn-outline-info" title="Manage Customer Bills">
                                            <i class="bi bi-receipt me-1"></i> Manage Bills
                                        </a>
                                        <a asp-controller="Admin" asp-action="PortalView" asp-route-accountNumber="@customer.AccountNumber" class="btn btn-outline-primary" title="Open Customer Portal View">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Portal View
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
