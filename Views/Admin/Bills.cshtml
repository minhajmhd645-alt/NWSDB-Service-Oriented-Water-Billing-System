@model NWSDB.Web.Models.BillListViewModel
@{
    ViewData["Title"] = "Bill Management - NWSDB Admin Control Panel";
    var statusOptions = new[] { "All", "Unpaid", "Paid", "Overdue" };
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Control Panel</a></li>
            <li class="breadcrumb-item active" aria-current="page">Bill Management</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-receipt-cutoff text-info me-2"></i> Bill Management</h2>
            <p class="text-muted mb-0">View, create, and administer NWSDB customer billing records.</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="CreateBill" class="btn btn-info text-white fw-semibold shadow-sm">
                <i class="bi bi-file-earmark-plus-fill me-1"></i> Issue New Bill
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="Admin" asp-action="Bills" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchAccount" value="@Model.SearchAccount" class="form-control border-start-0" placeholder="Search by Account Number or Bill ID..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="statusFilter" class="form-select">
                        @foreach (var opt in statusOptions)
                        {
                            if (opt == Model.StatusFilter)
                            {
                                <option value="@opt" selected>@(opt == "All" ? "All Statuses" : opt + " Bills")</option>
                            }
                            else
                            {
                                <option value="@opt">@(opt == "All" ? "All Statuses" : opt + " Bills")</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-semibold w-100">
                        <i class="bi bi-funnel-fill me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchAccount) || Model.StatusFilter != "All")
                    {
                        <a asp-controller="Admin" asp-action="Bills" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bills Table Card -->
    <div class="card border-0 shadow-sm bg-white">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-navy mb-0">Bills Found: <span class="badge bg-navy">@Model.Bills.Count()</span></h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-7">
                <thead class="table-light text-muted fw-semibold">
                    <tr>
                        <th>Bill #</th>
                        <th>Account</th>
                        <th>Billing Month</th>
                        <th>Prev Reading</th>
                        <th>Curr Reading</th>
                        <th>Units</th>
                        <th>Amount (Rs.)</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bills.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-5">
                                <i class="bi bi-receipt fs-1 d-block text-secondary mb-2"></i>
                                No bills found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var bill in Model.Bills)
                        {
                            var statusClass = bill.Status switch
                            {
                                "Paid" => "bg-success-subtle text-success border-success-subtle",
                                "Overdue" => "bg-danger-subtle text-danger border-danger-subtle",
                                _ => "bg-warning-subtle text-warning-emphasis border-warning-subtle"
                            };
                            var isOverdue = bill.Status == "Overdue" || (bill.Status == "Unpaid" && bill.DueDate < DateTime.UtcNow);
                            <tr class="@(isOverdue && bill.Status != "Paid" ? "table-warning-subtle" : "")">
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace border border-secondary-subtle px-2">
                                        #@bill.BillId
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 fs-7">
                                        @bill.AccountNumber
                                    </span>
                                </td>
                                <td class="fw-semibold">@bill.BillingMonth</td>
                                <td>@bill.PreviousReading</td>
                                <td>@bill.CurrentReading</td>
                                <td>@bill.UnitsConsumed units</td>
                                <td class="fw-bold">@bill.BillAmount.ToString("N2")</td>
                                <td class="@(bill.DueDate < DateTime.UtcNow && bill.Status != "Paid" ? "text-danger fw-semibold" : "")">
                                    @bill.DueDate.ToLocalTime().ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge border @statusClass px-2 py-1">@bill.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Admin" asp-action="BillDetails" asp-route-billId="@bill.BillId" class="btn btn-outline-secondary" title="View Bill Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="EditBill" asp-route-billId="@bill.BillId" class="btn btn-outline-primary" title="Edit Bill">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
