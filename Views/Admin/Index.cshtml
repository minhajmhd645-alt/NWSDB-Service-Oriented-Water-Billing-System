@model NWSDB.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Panel - Dashboard";
}

<div class="container py-4">
    <!-- Admin Header Banner -->
    <div class="card border-0 bg-navy text-white rounded-3 shadow mb-4">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
            <div>
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold text-uppercase tracking-wider mb-2">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Administration
                </span>
                <h2 class="fw-bold text-white mb-1">NWSDB Admin Control Panel</h2>
                <p class="text-white-50 mb-0">Customer & Billing Administration through NWSDB Service Architecture</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Admin" asp-action="Customers" class="btn btn-light fw-semibold text-navy">
                    <i class="bi bi-people-fill me-1"></i> Customers
                </a>
                <a asp-controller="Admin" asp-action="Bills" class="btn btn-outline-light fw-semibold">
                    <i class="bi bi-receipt-cutoff me-1"></i> Bills
                </a>
                <a asp-controller="Admin" asp-action="Payments" class="btn btn-outline-warning fw-semibold">
                    <i class="bi bi-credit-card-2-front me-1"></i> Payments
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics Cards Grid (Step 10) -->
    <div class="row g-3 mb-4">
        <!-- Total Customers Card -->
        <div class="col-sm-6 col-lg-4 col-xl-2-4">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-7 fw-semibold text-muted text-uppercase">Total Customers</span>
                        <div class="bg-primary-subtle text-primary p-2 rounded-circle">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-navy mb-0">@Model.Stats.TotalCustomers</h3>
                    <div class="fs-8 text-muted mt-1">Registered accounts</div>
                </div>
            </div>
        </div>

        <!-- Total Bills Card -->
        <div class="col-sm-6 col-lg-4 col-xl-2-4">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-7 fw-semibold text-muted text-uppercase">Total Bills</span>
                        <div class="bg-info-subtle text-info p-2 rounded-circle">
                            <i class="bi bi-file-earmark-text-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-navy mb-0">@Model.Stats.TotalBills</h3>
                    <div class="fs-8 text-muted mt-1">Generated statements</div>
                </div>
            </div>
        </div>

        <!-- Unpaid Bills Card -->
        <div class="col-sm-6 col-lg-4 col-xl-2-4">
            <div class="card border-0 shadow-sm h-100 bg-white border-start border-warning border-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-7 fw-semibold text-warning-emphasis text-uppercase">Unpaid Bills</span>
                        <div class="bg-warning-subtle text-warning p-2 rounded-circle">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-warning-emphasis mb-0">@Model.Stats.UnpaidBills</h3>
                    <div class="fs-8 text-muted mt-1">Rs. @Model.Stats.TotalOutstandingAmount.ToString("N2") pending</div>
                </div>
            </div>
        </div>

        <!-- Paid Bills Card -->
        <div class="col-sm-6 col-lg-4 col-xl-2-4">
            <div class="card border-0 shadow-sm h-100 bg-white border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-7 fw-semibold text-success text-uppercase">Paid Bills</span>
                        <div class="bg-success-subtle text-success p-2 rounded-circle">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-success mb-0">@Model.Stats.PaidBills</h3>
                    <div class="fs-8 text-muted mt-1">Settled invoices</div>
                </div>
            </div>
        </div>

        <!-- Payments Card -->
        <div class="col-sm-6 col-lg-4 col-xl-2-4">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-7 fw-semibold text-muted text-uppercase">Total Payments</span>
                        <div class="bg-indigo-subtle text-indigo p-2 rounded-circle">
                            <i class="bi bi-wallet2 fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-navy mb-0">@Model.Stats.TotalPayments</h3>
                    <div class="fs-8 text-muted mt-1">Rs. @Model.Stats.TotalRevenueCollected.ToString("N2") collected</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts & Recent Tables -->
    <div class="row g-4 mb-4">
        <!-- Quick Actions Panel -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm bg-white h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold text-navy mb-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Quick Administrative Actions</h5>
                </div>
                <div class="card-body p-3 space-y-3">
                    <a asp-controller="Admin" asp-action="CreateCustomer" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-3 rounded-3 text-start w-100 text-decoration-none">
                        <div>
                            <div class="fw-bold"><i class="bi bi-person-plus-fill me-2"></i> Register New Customer</div>
                            <small class="text-muted">Auto-generate account number & setup initial details</small>
                        </div>
                        <i class="bi bi-chevron-right text-primary"></i>
                    </a>

                    <a asp-controller="Admin" asp-action="CreateBill" class="btn btn-outline-info d-flex align-items-center justify-content-between p-3 rounded-3 text-start w-100 text-decoration-none">
                        <div>
                            <div class="fw-bold"><i class="bi bi-file-earmark-plus-fill me-2"></i> Issue Water Bill</div>
                            <small class="text-muted">Record meter readings & calculate billing amount</small>
                        </div>
                        <i class="bi bi-chevron-right text-info"></i>
                    </a>

                    <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-secondary d-flex align-items-center justify-content-between p-3 rounded-3 text-start w-100 text-decoration-none">
                        <div>
                            <div class="fw-bold"><i class="bi bi-search me-2"></i> Search Customer Registry</div>
                            <small class="text-muted">Search by account, name, address or phone</small>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Customers -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm bg-white h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-navy mb-0"><i class="bi bi-people me-2 text-primary"></i> Recent Customers</h5>
                    <a asp-controller="Admin" asp-action="Customers" class="btn btn-sm btn-light fw-semibold text-primary">View All Customers <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-7">
                        <thead class="table-light text-muted fw-semibold">
                            <tr>
                                <th>Account Number</th>
                                <th>Full Name</th>
                                <th>Phone Number</th>
                                <th>Email</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentCustomers.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No customers registered yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var customer in Model.RecentCustomers)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-7">
                                                @customer.AccountNumber
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-navy">@customer.FullName</td>
                                        <td>@customer.PhoneNumber</td>
                                        <td class="text-muted">@customer.Email</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Admin" asp-action="EditCustomer" asp-route-accountNumber="@customer.AccountNumber" class="btn btn-outline-secondary" title="Edit Customer">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                <a asp-controller="Admin" asp-action="CreateBill" asp-route-accountNumber="@customer.AccountNumber" class="btn btn-outline-info" title="Issue Bill">
                                                    <i class="bi bi-receipt"></i>
                                                </a>
                                                <a asp-controller="Admin" asp-action="PortalView" asp-route-accountNumber="@customer.AccountNumber" class="btn btn-outline-primary" title="Portal View">
                                                    <i class="bi bi-eye"></i> Portal
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
