@model NWSDB.Web.Models.CreateBillViewModel
@{
    ViewData["Title"] = "Issue New Bill - NWSDB Admin Control Panel";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb fs-7">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Control Panel</a></li>
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Bills" class="text-decoration-none">Bills</a></li>
            <li class="breadcrumb-item active" aria-current="page">Issue New Bill</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-navy text-white p-4 border-0">
                    <h4 class="fw-bold text-white mb-1"><i class="bi bi-file-earmark-plus-fill text-info me-2"></i> Issue New Water Bill</h4>
                    <p class="text-white-50 fs-7 mb-0">Enter meter readings. Bill amount is calculated from units consumed, or enter manually.</p>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Admin" asp-action="CreateBill" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Account Info Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AccountNumber" class="form-label fw-semibold text-navy"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-badge-fill"></i></span>
                                    <input asp-for="AccountNumber" class="form-control font-monospace text-uppercase" placeholder="e.g. NWSDB10001" required />
                                </div>
                                <span asp-validation-for="AccountNumber" class="text-danger fs-7 d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BillingMonth" class="form-label fw-semibold text-navy"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-month-fill"></i></span>
                                    <input asp-for="BillingMonth" class="form-control" placeholder="e.g. Oct-2026" required />
                                </div>
                                <span asp-validation-for="BillingMonth" class="text-danger fs-7 d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Meter Readings Section -->
                        <div class="card border border-info-subtle bg-info-subtle rounded-3 p-3 mb-3">
                            <h6 class="fw-bold text-info mb-3"><i class="bi bi-speedometer2 me-2"></i> Meter Readings</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="PreviousReading" class="form-label fw-semibold text-navy"></label>
                                    <input asp-for="PreviousReading" id="prevReading" class="form-control text-center fw-bold" type="number" min="0" oninput="calcUnits()" required />
                                    <span asp-validation-for="PreviousReading" class="text-danger fs-7 d-block mt-1"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CurrentReading" class="form-label fw-semibold text-navy"></label>
                                    <input asp-for="CurrentReading" id="currReading" class="form-control text-center fw-bold" type="number" min="0" oninput="calcUnits()" required />
                                    <span asp-validation-for="CurrentReading" class="text-danger fs-7 d-block mt-1"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold text-navy">Units Consumed</label>
                                    <input id="unitsDisplay" class="form-control text-center fw-bold bg-light text-info" type="text" readonly value="0" />
                                    <small class="text-muted fs-7">Auto-calculated</small>
                                </div>
                            </div>
                        </div>

                        <!-- Billing Details -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label asp-for="BillAmount" class="form-label fw-semibold text-navy"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-semibold text-success">Rs.</span>
                                    <input asp-for="BillAmount" id="billAmount" class="form-control fw-bold fs-6" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <small class="text-muted fs-7">Auto-calculated at Rs. 30/unit, or enter manually.</small>
                                <span asp-validation-for="BillAmount" class="text-danger fs-7 d-block mt-1"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DueDate" class="form-label fw-semibold text-navy"></label>
                                <input asp-for="DueDate" class="form-control" type="date" required />
                                <span asp-validation-for="DueDate" class="text-danger fs-7 d-block mt-1"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Status" class="form-label fw-semibold text-navy"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Unpaid">Unpaid</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Overdue">Overdue</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Admin" asp-action="Bills" class="btn btn-outline-secondary px-4 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-info text-white px-4 fw-semibold shadow-sm">
                                <i class="bi bi-file-earmark-check-fill me-1"></i> Issue Bill
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcUnits() {
            var prev = parseInt(document.getElementById('prevReading').value) || 0;
            var curr = parseInt(document.getElementById('currReading').value) || 0;
            var units = Math.max(0, curr - prev);
            document.getElementById('unitsDisplay').value = units + ' units';
            var amountField = document.getElementById('billAmount');
            if (!amountField.value || parseFloat(amountField.value) === 0) {
                amountField.value = (units * 30).toFixed(2);
            }
        }

        // Set date input default value
        document.addEventListener('DOMContentLoaded', function () {
            var dueDateInput = document.querySelector('[name="DueDate"]');
            if (dueDateInput && !dueDateInput.value) {
                var d = new Date();
                d.setDate(d.getDate() + 14);
                dueDateInput.value = d.toISOString().split('T')[0];
            }
            calcUnits();
        });
    </script>
}
