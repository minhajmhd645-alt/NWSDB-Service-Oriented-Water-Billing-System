@model NWSDB.ThirdPartyClient.Models.CustomerLookupViewModel
@{
    ViewData["Title"] = "Customer Billing History";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Billing History</li>
            </ol>
        </nav>
        <h2 class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i> Customer Billing History</h2>
        <p class="text-muted">Retrieve complete water bill history from NWSDB REST API.</p>
    </div>
</div>

<!-- Search Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form asp-controller="Bills" asp-action="Index" method="get" class="row g-3">
            <div class="col-md-8 col-lg-9">
                <label for="accountNumber" class="form-label fw-semibold">Account Number</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-receipt text-muted"></i></span>
                    <input type="text" id="accountNumber" name="accountNumber" class="form-control" placeholder="e.g. NWSDB10004" value="@Model.AccountNumber" required />
                </div>
            </div>
            <div class="col-md-4 col-lg-3 d-flex align-items-end">
                <button type="submit" class="btn btn-cyan btn-lg w-100 fw-bold"><i class="bi bi-search me-1"></i> Get Bills</button>
            </div>
        </form>
    </div>
</div>

@if (Model.IsServiceUnavailable)
{
    <div class="alert alert-danger shadow-sm rounded-3 p-4 mb-4">
        <i class="bi bi-cloud-slash-fill me-2 fs-4"></i> NWSDB services are temporarily unavailable. Please try again later.
    </div>
}
else if (Model.IsNotFound)
{
    <div class="alert alert-warning shadow-sm rounded-3 p-4 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i> Customer account was not found.
    </div>
}

@if (Model.Bills != null)
{
    @if (Model.Customer != null)
    {
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">Customer: @Model.Customer.FullName</h5>
                    <span class="text-muted fs-7">Account: @Model.Customer.AccountNumber &bull; @Model.Customer.Address</span>
                </div>
                <div>
                    <a asp-controller="Bills" asp-action="Unpaid" asp-route-accountNumber="@Model.Customer.AccountNumber" class="btn btn-outline-warning text-dark btn-sm fw-bold">
                        <i class="bi bi-exclamation-circle me-1"></i> View Unpaid Only
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-list-columns-reverse text-primary me-2"></i> Bill Statements</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Bills.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox display-4 mb-2 d-block text-secondary"></i>
                    No billing statements found for account <strong>@Model.AccountNumber</strong>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Bill Ref</th>
                                <th>Billing Period</th>
                                <th>Meter Reading</th>
                                <th>Units</th>
                                <th>Bill Amount</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model.Bills)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary font-monospace">BILL-@bill.BillId</span></td>
                                    <td class="fw-bold text-dark">@bill.BillingMonth</td>
                                    <td class="fs-7 text-muted">@bill.PreviousReading &rarr; @bill.CurrentReading</td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis">@bill.UnitsConsumed units</span></td>
                                    <td class="fw-bold text-primary">LKR @bill.BillAmount.ToString("N2")</td>
                                    <td>@bill.DueDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (bill.Status == "Paid")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Paid</span>
                                        }
                                        else if (bill.Status == "Overdue")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Unpaid</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (bill.Status != "Paid")
                                        {
                                            <a asp-controller="Payment" asp-action="Pay" asp-route-billId="@bill.BillId" asp-route-accountNumber="@Model.AccountNumber" asp-route-amount="@bill.BillAmount" asp-route-billingMonth="@bill.BillingMonth" class="btn btn-sm btn-success fw-bold">
                                                <i class="bi bi-credit-card me-1"></i> Pay
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7"><i class="bi bi-lock me-1"></i> Settled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
