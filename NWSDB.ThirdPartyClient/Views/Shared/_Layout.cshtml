@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var bankApiBaseUrl = Configuration["BankApiSettings:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7001";
    var bankScalarUrl = $"{bankApiBaseUrl}/scalar/v1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WaterPay Partner Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-subtle">
    <header>
        <!-- Top Partner Banner -->
        <div class="partner-top-bar text-white py-1 fs-7">
            <div class="container d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-check text-info me-1"></i> Authorized NWSDB Partner Portal &bull; REST API Integration</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Targeting API: https://localhost:7194</span>
                    <a href="@bankScalarUrl" target="_blank" rel="noopener noreferrer" class="badge bg-warning text-dark text-decoration-none fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> View Bank API
                    </a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center me-4" asp-controller="Home" asp-action="Index">
                    <div class="partner-logo me-2">
                        <i class="bi bi-droplet-half text-cyan fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold lh-1 text-white fs-5">WaterPay</div>
                        <div class="text-cyan fs-7 fw-medium">PARTNER PORTAL</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-badge me-1"></i> Customers
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-search me-2"></i> Account Lookup</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index" asp-route-accountNumber="NWSDB10004"><i class="bi bi-person-vcard me-2"></i> Summary (NWSDB10004)</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-receipt me-1"></i> Billing
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" asp-controller="Bills" asp-action="Index"><i class="bi bi-clock-history me-2"></i> Bill History</a></li>
                                <li><a class="dropdown-item" asp-controller="Bills" asp-action="Unpaid"><i class="bi bi-exclamation-triangle me-2"></i> Unpaid Bills</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usage" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Water Usage</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payment" asp-action="History"><i class="bi bi-credit-card-2-front me-1"></i> Payment History</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <form class="d-flex" asp-controller="Customer" asp-action="Index" method="get">
                            <div class="input-group input-group-sm">
                                <input class="form-control form-control-sm bg-dark text-white border-secondary" type="search" name="accountNumber" placeholder="Account Number..." aria-label="Search" value="@Context.Request.Query["accountNumber"]">
                                <button class="btn btn-cyan btn-sm" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </form>

                        <a href="@bankScalarUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-warning btn-sm fw-semibold text-nowrap d-inline-flex align-items-center">
                            <i class="bi bi-bank me-1"></i> View Bank API
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer bg-dark text-secondary py-3 mt-auto border-top border-secondary border-opacity-25">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center fs-7">
            <div>
                &copy; @DateTime.UtcNow.Year <strong class="text-light">WaterPay Organization Portal</strong> &bull; Third-Party NWSDB Service Integration
            </div>
            <div class="mt-2 mt-md-0 text-md-end text-muted d-flex align-items-center gap-3">
                <span>Architecture: Client &rarr; REST API &rarr; Database (Strict Boundary Enforced)</span>
                <a href="@bankScalarUrl" target="_blank" rel="noopener noreferrer" class="text-warning text-decoration-none hover-warning fs-7">
                    <i class="bi bi-box-arrow-up-right me-1"></i> View Bank API
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
