@model NWSDB.ThirdPartyClient.Models.PaymentChannelViewModel
@{
    ViewData["Title"] = "Payment Channel Confirmation";

    // Determine which mode to render
    bool isOfficialPortal = string.Equals(Model.SelectedChannel, "NwsdbOfficialPortal",
        System.StringComparison.OrdinalIgnoreCase);

    // Friendly display label for the chosen channel
    string channelLabel = Model.SelectedChannel switch
    {
        "NwsdbOfficialPortal" => "NWSDB Official Portal",
        "Cargills"            => "Cargills",
        "Keells"              => "Keells",
        "Telecom"             => "Telecom & Mobile Payments",
        "OtherUtilities"      => "Other Bill Payment Services",
        "MorePartners"        => "More Partners",
        _                     => Model.SelectedChannel ?? "Unknown"
    };

    string channelIcon = Model.SelectedChannel switch
    {
        "NwsdbOfficialPortal" => "bi-droplet-fill",
        "Cargills"            => "bi-shop",
        "Keells"              => "bi-cart3",
        "Telecom"             => "bi-phone-fill",
        "OtherUtilities"      => "bi-credit-card-2-front-fill",
        "MorePartners"        => "bi-plus-circle-fill",
        _                     => "bi-building"
    };

    // Build the Pay action URL with channelName query-string
    string payUrl = Url.Action("Pay", "Payment", new
    {
        billId        = Model.BillId,
        accountNumber = Model.AccountNumber,
        amount        = Model.Amount,
        billingMonth  = Model.BillingMonth,
        channelName   = channelLabel
    })!;
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item">
                    <a asp-controller="Bills" asp-action="Unpaid" asp-route-accountNumber="@Model.AccountNumber">Unpaid Bills</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Payment" asp-action="SelectChannel"
                       asp-route-billId="@Model.BillId"
                       asp-route-accountNumber="@Model.AccountNumber"
                       asp-route-amount="@Model.Amount"
                       asp-route-billingMonth="@Model.BillingMonth">Choose Channel</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Channel Confirmed</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">

        @if (isOfficialPortal)
        {
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MODE A: NWSDB Official Portal                              -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header p-4 text-white"
                     style="background: linear-gradient(135deg, #0d6efd 0%, #0a3a8f 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white text-primary rounded-3 d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;font-size:1.8rem;flex-shrink:0;">
                            <i class="bi bi-droplet-fill"></i>
                        </div>
                        <div>
                            <div class="badge bg-white text-primary fw-bold mb-1">Official NWSDB Channel</div>
                            <h4 class="fw-bold mb-0">NWSDB Official Portal Selected</h4>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-primary d-flex align-items-start gap-3 rounded-3 mb-4">
                        <i class="bi bi-info-circle-fill fs-4 text-primary mt-1"></i>
                        <div>
                            <strong>You have selected the NWSDB Official Portal.</strong><br>
                            <span class="fs-7 text-muted">
                                This will take you to the official NWSDB Web customer portal
                                (<code>NWSDB.Web</code>) where you can log in and pay your bill
                                directly through the NWSDB official interface.
                            </span>
                        </div>
                    </div>

                    <!-- Architecture note -->
                    <div class="bg-light border rounded-3 p-3 mb-4 fs-7">
                        <div class="fw-bold text-dark mb-2">
                            <i class="bi bi-diagram-3 me-1 text-primary"></i> Architecture Note
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-primary">NWSDB Web Portal</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge bg-success">NWSDB REST API</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge bg-secondary">NWSDB Database</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">
                            The NWSDB Official Portal is a first-party consumer of the same NWSDB REST API
                            used by this third-party portal. Both clients share the same API contract.
                        </p>
                    </div>

                    <!-- Bill summary -->
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <div class="row g-2 fs-7">
                            <div class="col-6 text-muted">Bill Reference</div>
                            <div class="col-6 fw-bold font-monospace">NWSDB-BILL-@Model.BillId</div>
                            <div class="col-6 text-muted">Account</div>
                            <div class="col-6 fw-bold font-monospace">@Model.AccountNumber</div>
                            <div class="col-6 text-muted">Amount Due</div>
                            <div class="col-6 fw-bold text-danger">LKR @Model.Amount.ToString("N2")</div>
                        </div>
                    </div>

                    <div class="d-grid gap-3 d-md-flex justify-content-md-between align-items-center">
                        <a asp-controller="Payment" asp-action="SelectChannel"
                           asp-route-billId="@Model.BillId"
                           asp-route-accountNumber="@Model.AccountNumber"
                           asp-route-amount="@Model.Amount"
                           asp-route-billingMonth="@Model.BillingMonth"
                           class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-1"></i> Change Channel
                        </a>
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <a href="@Model.NwsdbWebBaseUrl" target="_blank" rel="noopener noreferrer"
                               class="btn btn-primary btn-lg fw-bold px-4">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Continue to NWSDB Official Portal
                            </a>
                            <a href="@payUrl" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-arrow-right-circle me-1"></i> Continue with Demo Payment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MODE B: Third-Party Partner (Cargills / Keells / etc.)     -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header p-4 text-white"
                     style="background: linear-gradient(135deg, #495057 0%, #212529 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white text-dark rounded-3 d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;font-size:1.8rem;flex-shrink:0;">
                            <i class="bi @channelIcon"></i>
                        </div>
                        <div>
                            <div class="badge bg-warning text-dark fw-bold mb-1">Partner Payment Channel</div>
                            <h4 class="fw-bold mb-0">@channelLabel</h4>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- SOC Demo notice -->
                    <div class="alert alert-warning d-flex align-items-start gap-3 rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning mt-1"></i>
                        <div>
                            <strong>Service-Oriented Computing — Demonstration Channel</strong><br>
                            <span class="fs-7 text-muted">
                                This partner channel (<strong>@channelLabel</strong>) is represented for
                                SOC assignment demonstration purposes only. No real integration with
                                @channelLabel exists. The actual payment will be processed through the
                                existing demo payment flow.
                            </span>
                        </div>
                    </div>

                    <!-- Architecture note -->
                    <div class="bg-light border rounded-3 p-3 mb-4 fs-7">
                        <div class="fw-bold text-dark mb-2">
                            <i class="bi bi-diagram-3 me-1 text-secondary"></i> Demo Payment Architecture
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-dark">ThirdPartyClient</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge bg-success">NWSDB API</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge bg-warning text-dark">Bank.API</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge bg-info text-dark">Dummy Payment Gateway</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">
                            In a real deployment, <strong>@channelLabel</strong> would integrate its
                            own frontend with the NWSDB REST API. This portal demonstrates the concept
                            by using the WaterPay ThirdPartyClient as a stand-in.
                        </p>
                    </div>

                    <!-- What will happen -->
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <div class="fw-semibold text-dark mb-2 fs-7">
                            <i class="bi bi-list-check me-1"></i> What happens next
                        </div>
                        <ul class="mb-0 fs-7 text-muted ps-3">
                            <li>You will be taken to the <strong>WaterPay Demo Payment Form</strong>.</li>
                            <li>Select a demo bank account and confirm the payment.</li>
                            <li>The request goes to <code>NWSDB.API → Bank.API → Dummy Payment Gateway</code>.</li>
                            <li>You will receive a success or failure result page with a full receipt.</li>
                        </ul>
                    </div>

                    <!-- Bill summary -->
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <div class="row g-2 fs-7">
                            <div class="col-6 text-muted">Bill Reference</div>
                            <div class="col-6 fw-bold font-monospace">NWSDB-BILL-@Model.BillId</div>
                            <div class="col-6 text-muted">Account</div>
                            <div class="col-6 fw-bold font-monospace">@Model.AccountNumber</div>
                            <div class="col-6 text-muted">Amount Due</div>
                            <div class="col-6 fw-bold text-danger">LKR @Model.Amount.ToString("N2")</div>
                            <div class="col-6 text-muted">Selected Channel</div>
                            <div class="col-6 fw-bold">@channelLabel</div>
                        </div>
                    </div>

                    <div class="d-grid gap-3 d-md-flex justify-content-md-between align-items-center">
                        <a asp-controller="Payment" asp-action="SelectChannel"
                           asp-route-billId="@Model.BillId"
                           asp-route-accountNumber="@Model.AccountNumber"
                           asp-route-amount="@Model.Amount"
                           asp-route-billingMonth="@Model.BillingMonth"
                           class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-1"></i> Change Channel
                        </a>
                        <a href="@payUrl" class="btn btn-success btn-lg fw-bold px-5">
                            <i class="bi bi-check-circle-fill me-1"></i> Continue with Demo Payment
                        </a>
                    </div>

                </div>
            </div>
        }

    </div>
</div>
