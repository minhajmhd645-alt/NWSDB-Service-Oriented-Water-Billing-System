@model NWSDB.ThirdPartyClient.Models.PaymentResultViewModel
@{
    ViewData["Title"] = "Payment Success";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white text-center p-5">
                <div class="success-icon bg-white text-success rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow">
                    <i class="bi bi-check-lg display-3"></i>
                </div>
                <h2 class="fw-bold mb-1">Payment Successful!</h2>
                <p class="lead mb-0 text-white-75">Your utility bill payment has been successfully processed.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-success-subtle border border-success-subtle text-success-emphasis rounded-3 p-3 mb-4 d-flex align-items-center">
                    <i class="bi bi-shield-check fs-4 me-3"></i>
                    <div>
                        <strong>Transaction Verified:</strong> The payment was authorized by the Bank API and settled in NWSDB billing database.
                    </div>
                </div>

                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Transaction Receipt Details</h5>

                <div class="row g-3 fs-6 mb-4">
                    <div class="col-sm-6 text-muted">Payment Reference ID:</div>
                    <div class="col-sm-6 fw-bold text-sm-end"><span class="badge bg-dark font-monospace fs-6">PAY-@(Model.Payment?.PaymentId ?? 0)</span></div>

                    <div class="col-sm-6 text-muted">Bill Reference:</div>
                    <div class="col-sm-6 fw-bold text-sm-end font-monospace">NWSDB-BILL-@Model.BillId</div>

                    <div class="col-sm-6 text-muted">Customer Account:</div>
                    <div class="col-sm-6 fw-bold text-sm-end font-monospace">@Model.AccountNumber</div>

                    <div class="col-sm-6 text-muted">Bank Transaction Ref:</div>
                    <div class="col-sm-6 fw-bold text-sm-end text-primary font-monospace">@(Model.Payment?.TransactionId ?? "N/A")</div>

                    <div class="col-sm-6 text-muted">Payment Method:</div>
                    <div class="col-sm-6 fw-semibold text-sm-end">@(Model.Payment?.PaymentMethod ?? "DemoBankAccount")</div>

                    <div class="col-sm-6 text-muted">Payment Timestamp:</div>
                    <div class="col-sm-6 fw-semibold text-sm-end">@(Model.Payment?.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss") ?? DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</div>

                    <div class="col-sm-6 text-muted fs-5 fw-bold">Amount Paid:</div>
                    <div class="col-sm-6 fs-4 fw-bold text-success text-sm-end">LKR @((Model.Payment?.Amount ?? Model.AttemptedAmount).ToString("N2"))</div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-between border-top pt-4">
                    <a asp-controller="Bills" asp-action="Index" asp-route-accountNumber="@Model.AccountNumber" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-receipt me-1"></i> Back to Bills
                    </a>
                    <a asp-controller="Payment" asp-action="History" asp-route-accountNumber="@Model.AccountNumber" class="btn btn-primary btn-lg fw-bold">
                        <i class="bi bi-clock-history me-1"></i> View Payment History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
