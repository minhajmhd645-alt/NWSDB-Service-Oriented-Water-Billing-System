@model NWSDB.ThirdPartyClient.Models.CustomerLookupViewModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Payment History</li>
            </ol>
        </nav>
        <h2 class="fw-bold"><i class="bi bi-credit-card-2-front me-2 text-success"></i> Customer Payment History</h2>
        <p class="text-muted">Retrieve verified payment audit records from NWSDB REST API.</p>
    </div>
</div>

<!-- Search Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form asp-controller="Payment" asp-action="History" method="get" class="row g-3">
            <div class="col-md-8 col-lg-9">
                <label for="accountNumber" class="form-label fw-semibold">Account Number</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-person-vcard text-muted"></i></span>
                    <input type="text" id="accountNumber" name="accountNumber" class="form-control" placeholder="e.g. NWSDB10004" value="@Model.AccountNumber" required />
                </div>
            </div>
            <div class="col-md-4 col-lg-3 d-flex align-items-end">
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold"><i class="bi bi-search me-1"></i> Get Payments</button>
            </div>
        </form>
    </div>
</div>

@if (Model.IsServiceUnavailable)
{
    <div class="alert alert-danger shadow-sm rounded-3 p-4 mb-4">
        <i class="bi bi-cloud-slash-fill me-2 fs-4"></i> NWSDB services are temporarily unavailable. Please try again later.
    </div>
}
else if (Model.IsNotFound)
{
    <div class="alert alert-warning shadow-sm rounded-3 p-4 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i> Customer account was not found.
    </div>
}

@if (Model.PaymentHistory != null)
{
    @if (Model.Customer != null)
    {
        <div class="card border-0 shadow-sm mb-4 bg-success-subtle border-start border-success border-4">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-success-emphasis">Customer: @Model.Customer.FullName</h5>
                    <span class="text-muted fs-7">Account: @Model.Customer.AccountNumber &bull; Phone: @Model.Customer.PhoneNumber</span>
                </div>
                <div>
                    <span class="badge bg-success fs-6 px-3 py-2">Total Payments: @Model.PaymentHistory.Count()</span>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff text-success me-2"></i> Payment Audit Trail</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.PaymentHistory.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-credit-card display-4 mb-2 d-block text-secondary"></i>
                    No payment history recorded for account <strong>@Model.AccountNumber</strong>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Payment ID</th>
                                <th>Bill Reference</th>
                                <th>Bank Transaction ID</th>
                                <th>Amount Paid</th>
                                <th>Payment Method</th>
                                <th>Payment Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.PaymentHistory)
                            {
                                <tr>
                                    <td><span class="badge bg-dark font-monospace">PAY-@payment.PaymentId</span></td>
                                    <td><span class="badge bg-secondary font-monospace">BILL-@payment.BillId</span></td>
                                    <td class="font-monospace text-primary fw-semibold">@payment.TransactionId</td>
                                    <td class="fw-bold text-success">LKR @payment.Amount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@payment.PaymentMethod</span></td>
                                    <td class="fs-7">@payment.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        @if (payment.Status == "Success")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Success</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> @payment.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
